{
  // Dormant by default. `triggers.crons` is an explicit empty list: deploying this file REMOVES any cron
  // trigger (Cloudflare: "set crons to an empty array" deletes them), and SCAN_ENABLED "false" makes even a
  // manually fired scheduled event a no-op. Both are the kill switch; see scheduler/README.md.
  "name": "coin-radar-scan-scheduler",
  "main": "./worker.ts",
  "compatibility_date": "2026-05-22",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": [] },
  "vars": { "SCAN_ENABLED": "false" },
  "observability": { "enabled": true }
}
